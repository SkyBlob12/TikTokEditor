node_modules/

# Aucun projet n'est versionne. Un projet, ce sont tes rushes et tes montages :
# ca ne regarde pas le depot, et ca evite de publier par accident un brief, une
# transcription ou un plan personnel.
projects/*
!projects/_library/
exports/
.env

# La bibliotheque partagee contient des fichiers sous licence : on garde la
# structure et les notices, pas les fichiers.
projects/_library/*
!projects/_library/LICENCES.md
!projects/_library/sfx/
!projects/_library/music/
!projects/_library/brand/
projects/_library/sfx/*
projects/_library/music/*
projects/_library/brand/*
!projects/_library/sfx/LISEZ-MOI.md

# Fichiers de travail
projects/*/.transcribe.wav
whisper-bin-x64.zip
tmp/
